rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-Trust: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAppChecked() {
      // Enforce App Check if available
      return request.auth.token.firebase.app_id != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.displayName is string && data.displayName.size() <= 100
            && data.highScore is number
            && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
      }

      // Public profiles are readable by signed-in users (e.g. for leaderboard)
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.highScore > 0;
      
      allow create: if isOwner(userId) && isValidUser(incoming()) 
                   && incoming().highScore == 0;
      
      allow update: if isOwner(userId) && isValidUser(incoming())
                   && (
                     incoming().highScore >= existing().highScore
                     && incoming().diff(existing()).affectedKeys().hasOnly(['highScore', 'displayName', 'photoURL', 'updatedAt'])
                   );
    }

    // --- Scores Collection ---
    match /scores/{scoreId} {
      function isValidScore(data) {
        return data.userId == request.auth.uid
            && data.value is number
            && data.createdAt == request.time;
      }

      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidScore(incoming());
    }
  }
}
